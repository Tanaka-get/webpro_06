<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>図鑑NO．</h2>
  <table>
    <tr><th>ID</th><th>タイプ</th><th>名前</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.code %></td>
        <td><%= row.name %></td></tr>
      <% } %>
  </table>
</body>
</html>